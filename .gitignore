# --- SECRETS -----------------------------------------------------------------
# db.sqlite3 holds AppSettings, which stores the WhatsApp access token, the
# Gmail app password and the Claude API key. It must NEVER reach GitHub.
db.sqlite3
db.sqlite3-journal
*.sqlite3

.env
.env.*
!.env.example
local_settings.py
secrets.json
*.pem
*.key

# --- Client files ------------------------------------------------------------
# Uploaded documents and chat attachments belong to clients, not to the repo.
/media/*
!/media/.gitkeep

